include ../MatekH743/hwdef.dat

# Default: AP_HW_MatekL431
undef APJ_BOARD_ID
APJ_BOARD_ID AP_HW_HoWiCan
env AP_PERIPH 1

undef ROMFS
undef HAL_HAVE_SAFETY_SWITCH
undef IMU
undef BOOTLOADER_DEV_LIST
undef HAL_OS_FATFS_IO
undef OSD_ENABLED
undef SDMMC1

define HAL_CAN_DRIVER_DEFAULT 1
env BUILD_ABIN False

# ................... Serials: ...................................

# bootloader embedding / bootloader flashing not available
# define AP_BOOTLOADER_FLASHING_ENABLED 0

# We need UART1 for Telemetry input
# undef STDOUT_SERIAL
define HAL_USE_SERIAL TRUE

undef AP_PERIPH_MAG_ENABLED 
undef AP_PERIPH_RC_OUT_ENABLED 
undef AP_PERIPH_NOTIFY_ENABLED 
undef AP_SERIALLED_ENABLED 
define HAL_USE_ADC FALSE

# blue LED1 marked as ACT                                                                                           
undef PE4 
PE4 LED OUTPUT HIGH                                                                                               
define HAL_LED_ON 1

# order of UARTs (and USB)
undef SERIAL_ORDER
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 USART6 UART7 UART8 OTG2
                                                                                                                    
# USART1 (telem2) : match
# Default: PA10 USART1_RX USART1
# Default: PA9  USART1_TX USART1

# USART2 (GPS1) : match
# Default: PD5 USART2_TX USART2
# Default: PD6 USART2_RX USART2

# USART3 (GPS2) : match
# Default: PD9 USART3_RX USART3
# Default: PD8 USART3_TX USART3

# UART4 (spare) : match
# Default: PB9 UART4_TX UART4
# Default: PB8 UART4_RX UART4

# ======== by GrayCat: ================
undef DEFAULT_SERIAL2_PROTOCOL

define BOOTLOADER_BAUDRATE 19200

# enable ESC control
define HAL_SERIAL_ESC_COMM_ENABLED 1
# define HAL_SUPPORT_RCOUT_SERIAL 1
define HAL_WITH_ESC_TELEM 1
HAL_WITH_ESC_TELEM 1
                                                                                                                    
define AP_PERIPH_SERIAL_OPTIONS_ENABLED 1
                                                                                                                   
define DEFAULT_SERIAL2_PROTOCOL  SerialProtocol_Scripting
DEFAULT_SERIAL2_PROTOCOL  SerialProtocol_Scripting
SERIAL2_PROTOCOL SerialProtocol_Scripting
define SERIAL2_PROTOCOL SerialProtocol_Scripting

define DEFAULT_SERIAL2_BAUD 19200
define SERIAL2_BAUD 19200
SERIAL2_BAUD 19200

define DEFAULT_SERIAL3_BAUD 19200
# SERIAL3_PROTOCOL SerialProtocol_ESCTelemetry
SERIAL3_BAUD 19200

define DEFAULT_SERIAL3_PROTOCOL  SerialProtocol_Scripting
DEFAULT_SERIAL3_PROTOCOL  SerialProtocol_Scripting
SERIAL3_PROTOCOL SerialProtocol_Scripting
define SERIAL3_PROTOCOL SerialProtocol_Scripting

AP_EXTENDED_ESC_TELEM_ENABLED 0
define AP_EXTENDED_ESC_TELEM_ENABLED 0

# ................. PWMs: .....................
define ESC_TELEM_MAX_ESCS 4                                                                                         
BRD_SAFETY_MASK 15  
OUT_BLH_BDMASK 15                                                                                                   
