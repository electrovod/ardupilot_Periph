# up to 9 motors/servos


# Bi-Directional DShot 600
# ESC_PWM_TYPE 7
# OUT_BLH_BDMASK 15

# DShot telem on RX1
ESC_TELEM_PORT 0

# .. by GrayCat:
# FLASH_BOOTLOADER 1
MAV_TELEM_DELAY 4
ESC_TELEM_RATE 5
# ESC_EXT_TLM_RATE 5

# .. Outputs, for MUCAN:
ESC_CMD_TIMO 5000
OUT1_FUNCTION 33
OUT1_MIN 1000
OUT1_MAX 2000
ESC_PWM_TYPE 1
OUT2_FUNCTION 34
MOT_SAFE_DISARM 0

