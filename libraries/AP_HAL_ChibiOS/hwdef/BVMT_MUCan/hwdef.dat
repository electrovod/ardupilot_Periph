include ../MatekL431/hwdef.inc

# make the UARTn numbers in parameters match the silkscreen
undef SERIAL_ORDER
SERIAL_ORDER EMPTY USART1 USART2 USART3

define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry
# define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_ESCTelemetry

# Default: AP_HW_MatekL431
undef APJ_BOARD_ID
APJ_BOARD_ID AP_HW_MUCAN

# bootloader embedding / bootloader flashing not available
# define AP_BOOTLOADER_FLASHING_ENABLED 0

# We need UART1 for Telemetry input
# undef STDOUT_SERIAL 
define HAL_USE_SERIAL TRUE

 --------------------- PWM -----------------------
PA8   TIM1_CH1  TIM1 PWM(1) GPIO(50)
PA9   TIM1_CH2  TIM1 PWM(2) GPIO(51)
PA10  TIM1_CH3  TIM1 PWM(3) GPIO(52)
PA11  TIM1_CH4  TIM1 PWM(4) GPIO(53)
PA15  TIM2_CH1  TIM2 PWM(5) GPIO(54)

# Beeper
PA6   TIM16_CH1 TIM16 GPIO(32) ALARM


# ---------------------- COMPASS ---------------------------
define AP_PERIPH_MAG_ENABLED 1

SPIDEV  rm3100 SPI1 DEVID1   MAG_CS MODE0  1*MHZ  1*MHZ
COMPASS RM3100 SPI:rm3100 false ROTATION_PITCH_180

define HAL_COMPASS_MAX_SENSORS 1

# added QMC5883L for different board varients
COMPASS QMC5883L I2C:0:0xd false ROTATION_PITCH_180_YAW_90


# -------------------- MSP --------------------------------
# define AP_PERIPH_MSP_ENABLED 0

# -------------------- Buzzer+NeoPixels --------------d------
define AP_PERIPH_RC_OUT_ENABLED 1
define AP_PERIPH_NOTIFY_ENABLED 1
define AP_SERIALLED_ENABLED 1

# ======== by GrayCat: ================
define HAL_USE_ADC FALSE
undef DEFAULT_SERIAL2_PROTOCOL 

define BOOTLOADER_BAUDRATE 19200

define ESC_TELEM_MAX_ESCS 4

# enable ESC control
define HAL_SERIAL_ESC_COMM_ENABLED 1
define HAL_SUPPORT_RCOUT_SERIAL 1
define HAL_WITH_ESC_TELEM 1

define AP_PERIPH_SERIAL_OPTIONS_ENABLED 1

# USART2 for MSP
undef PA3
undef PA2
PA2 USART2_TX USART2 SPEED_HIGH
PA3 USART2_RX USART2 SPEED_HIGH
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry
DEFAULT_SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry
SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry
define DEFAULT_SERIAL2_BAUD 19200
SERIAL2_BAUD 19200

# enable Serial3 port with DMA
undef PB10
undef PB11
PB10  USART3_TX USART3 SPEED_HIGH
PB11  USART3_RX USART3 SPEED_HIGH
define DEFAULT_SERIAL3_BAUD 19200
SERIAL3_PROTOCOL SerialProtocol_ESCTelemetry
SERIAL3_BAUD 19200

# define  AP_RPM_ENABLED 1
# define  HAL_ENABLE_DRONECAN_DRIVERS 1
# define  AP_RPM_DRONECAN_ENABLED 1
# define  AP_RPM_ESC_TELEM_OUTBOUND_ENABLED 1
# undef  AP_AIRSPEED_DRONECAN_ENABLED


