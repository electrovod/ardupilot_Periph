include ../MatekL431/hwdef.inc

# make the UARTn numbers in parameters match the silkscreen
undef SERIAL_ORDER
SERIAL_ORDER EMPTY USART1 USART2 USART3

define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry
# define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_ESCTelemetry

# Default: AP_HW_MatekL431
undef APJ_BOARD_ID
APJ_BOARD_ID AP_HW_MUCAN

# bootloader embedding / bootloader flashing not available
# define AP_BOOTLOADER_FLASHING_ENABLED 0

# We need UART1 for Telemetry input
# undef STDOUT_SERIAL 
define HAL_USE_SERIAL TRUE

# blue LED0 marked as ACT
# PB3 LED OUTPUT HIGH
# define HAL_LED_ON 1

#  --------------------- PWM -----------------------
undef   PB10 
PA8   TIM1_CH1   TIM1 PWM(2) GPIO(51)
PA9   TIM1_CH2   TIM1 PWM(3) GPIO(52)
# PA10  TIM1_CH3  TIM1 PWM(3) GPIO(52)
PA11  TIM1_CH4   TIM1 PWM(4) GPIO(53)
PA15  TIM2_CH1   TIM2 PWM(5) GPIO(54)

BRD_SAFETY_MASK 15

# Beeper
PA6   TIM16_CH1 TIM16 GPIO(32) ALARM

# ---------------------- COMPASS ---------------------------
define AP_PERIPH_MAG_ENABLED 0

define HAL_COMPASS_MAX_SENSORS 0


# ======= Temperature:
define AP_PERIPH_DEVICE_TEMPERATURE_ENABLED 1
AP_PERIPH_DEVICE_TEMPERATURE_ENABLED 1
# ..... Set up Pins for  SPI1
# Already defined in Include: PA5 SPI1_SCK SPI1
# Already defined in Include: PB4 SPI1_MISO SPI1
undef PA4
# .... Set up  Chip Select (CS) for MAX6675:
undef PB10
PB10 MAX6675_CS CS
define AP_TEMPERATURE_SENSOR_ENABLED 1
define AP_TEMPERATURE_SENSOR_MAX31865_ENABLED 1

#  Definition of programmatic  SPI-device for ArduPilot
SPIDEV max31865 SPI1 DEVID1 MAX6675_CS MODE0  100*KHZ 100*KHZ

# -------------------- Buzzer+NeoPixels --------------------

# ======== by GrayCat: ================

AP_PERIPH_BATTERY_ENABLED
define AP_PERIPH_BATTERY_ENABLED 1
# :: 29 == Scripting
define HAL_BATT_MONITOR_DEFAULT 29

# ====== ADC pins
define HAL_USE_ADC TRUE
undef  HAL_ANALOG3_PINS
define HAL_WITH_MCU_MONITORING 1
define STM32_ADC_USE_ADC1 TRUE

# ....  ADC : ..........................................................
# ------------------ BATTERY Monitor -----------------------
define AP_PERIPH_BATTERY_ENABLED 1
# undef PB0
PB0 BATT_VOLTAGE_SENS  ADC1 SCALE(1)
PB1 BATT_CURRENT_SENS  ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 15
define HAL_BATT_CURR_PIN 16
define HAL_BATT_VOLT_SCALE 1.0
define HAL_BATT_CURR_SCALE 1.0


undef DEFAULT_SERIAL2_PROTOCOL 
define BOOTLOADER_BAUDRATE 19200
# define ESC_TELEM_MAX_ESCS 15

# enable ESC control
# define AP_PERIPH_RC_OUT_ENABLED 1
# define HAL_SERIAL_ESC_COMM_ENABLED 1
# define HAL_SUPPORT_RCOUT_SERIAL 1
#  define HAL_WITH_ESC_TELEM 1
# OUT_BLH_BDMASK 0

define AP_PERIPH_SERIAL_OPTIONS_ENABLED 1

# USART2 for MSP
undef PA3
undef PA2
PA2 USART2_TX USART2 SPEED_HIGH
PA3 USART2_RX USART2 SPEED_HIGH

# define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry
# DEFAULT_SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry
# SERIAL2_PROTOCOL SerialProtocol_ESCTelemetry

define DEFAULT_SERIAL2_PROTOCOL  SerialProtocol_Scripting
DEFAULT_SERIAL2_PROTOCOL  SerialProtocol_Scripting
SERIAL2_PROTOCOL SerialProtocol_Scripting
define SERIAL2_PROTOCOL SerialProtocol_Scripting

define DEFAULT_SERIAL2_BAUD 19200
define SERIAL2_BAUD 19200
SERIAL2_BAUD 19200

# AP_EXTENDED_ESC_TELEM_ENABLED 1
# define AP_EXTENDED_ESC_TELEM_ENABLED 1

# .... Debug pins:
PA0 EXTERN_GPIO1 OUTPUT GPIO(1)
PA1 EXTERN_GPIO2 OUTPUT GPIO(2)

# RM3100 DIS-able:
PA4 EXTERN_GPIO3 OUTPUT GPIO(3) HIGH

# BARO
define AP_PERIPH_BARO_ENABLED 1
define BARO_MAX_INSTANCES 1

# =========== AirSpeed emulation:
define AP_PERIPH_AIRSPEED_ENABLED 1

# Types: "20"==Scripting;
define HAL_AIRSPEED_TYPE_DEFAULT 20
define AIRSPEED_MAX_SENSORS 1

