# up to 9 motors/servos


# Bi-Directional DShot 600
# ESC_PWM_TYPE 7
# OUT_BLH_BDMASK 15

# DShot telem on RX1
ESC_TELEM_PORT 0

# .. by GrayCat:
# FLASH_BOOTLOADER 1
MAV_TELEM_DELAY 4
ESC_TELEM_RATE 5
ESC_EXT_TLM_RATE 5

# .. Outputs, for MUCAN:
ESC_CMD_TIMO 5000
MOT_SAFE_DISARM 0

BATT_SERIAL_NUM 1
BATT_CAPACITY 60000
# BATT_ESC_INDEX 13
BAL_RATE 1

TEMP1_TYPE 3
TEMP1_BUS 1
#  :: 1=="ESC" ; 3="Battery Index"; 
TEMP1_SRC 3
TEMP1_SRC_ID 1
TEMP_MSG_RATE 2


