    # .......... Ser 7 settings:
define DEFAULT_SERIAL7_BAUD 19200
SERIAL7_BAUD 19200
define DEFAULT_SERIAL7_PROTOCOL  SerialProtocol_Scripting
DEFAULT_SERIAL7_PROTOCOL  SerialProtocol_Scripting
SERIAL7_PROTOCOL SerialProtocol_Scripting
