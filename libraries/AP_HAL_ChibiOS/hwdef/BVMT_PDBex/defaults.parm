# .. by GrayCat:
# FLASH_BOOTLOADER 1
# MAV_TELEM_DELAY 2

BRD_BOOT_DELAY 3000
BOOT_DELAY 3000
# : Telemetry startup delay, seconds
MAV_TELEM_DELAY 3

CAN_MIRROR_PORTS 3


# Working: ESC_TELEM_RATE 15
# Working: ESC_EXT_TLM_RATE 15
# Debug:
ESC_TELEM_RATE 5
ESC_EXT_TLM_RATE 5

# 'Herz', base frequency for PWM RC outputs:
OUT_RATE 50

# .. Outputs, for MUCAN:
ESC_CMD_TIMO 3000
ESC_PWM_TYPE 1

# Analog:
BATT_SERIAL_NUM 3
BATT_CAPACITY 60000
BATT_ESC_INDEX 9

BATT2_SERIAL_NUM 4
BATT2_MONITOR 4
BATT2_SERIAL_NUM 4
BATT2_ESC_INDEX 9

BAL_RATE 1
TEMP1_TYPE 3
TEMP1_BUS 3
#  :: 1=="ESC" ; 3="Battery Index"; 
TEMP1_SRC 3
TEMP1_SRC_ID 1
TEMP_MSG_RATE 1
