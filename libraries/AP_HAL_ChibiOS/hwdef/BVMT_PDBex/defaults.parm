# .. by GrayCat:
# FLASH_BOOTLOADER 1
# MAV_TELEM_DELAY 2

BRD_BOOT_DELAY 500
BOOT_DELAY 500
# : Telemetry startup delay, seconds
MAV_TELEM_DELAY 1

# Bi-Directional Mirror CAN[0]-CAN[1] :
CAN_MIRROR_PORTS 3

# Working: ESC_TELEM_RATE 15
# Working: ESC_EXT_TLM_RATE 15
# Debug:
ESC_TELEM_RATE 5
ESC_EXT_TLM_RATE 5

# 'Herz', base frequency for PWM RC outputs:
OUT_RATE 50

# .. Outputs, for MUCAN:
ESC_CMD_TIMO 3000
ESC_PWM_TYPE 1

# Analog:
BATT_SERIAL_NUM 4
BATT_CAPACITY 60000
BATT_ESC_INDEX 11

BATT2_SERIAL_NUM 4
BATT2_MONITOR 4
BATT2_SERIAL_NUM 4
BATT2_ESC_INDEX 9

BAL_RATE 1
# for MAX6675, TEMP1_TYPE 3
# for AD7414,: TEMP1_TYPE 10
TEMP1_TYPE 10
# TEMP1_BUS 0
TEMP1_ADDR = 73

#  :: 1=="ESC" ; 3="Battery Index"; 
TEMP1_SRC 3
TEMP1_SRC_ID 5
TEMP_MSG_RATE 1

OUT_32_ENABLE 1
OUT1_FUNCTION 71
OUT2_FUNCTION 72
OUT3_FUNCTION 73
OUT4_FUNCTION 74
OUT5_FUNCTION 75
OUT6_FUNCTION 76
OUT7_FUNCTION 77
OUT8_FUNCTION 78
