# hw definition file for processing by chibios_pins.py
# hardware repository: https://github.com/ARK-Electronics/ARK_CANNODE
# Converted by GrayCat from ARK_CANNODE

# MCU class and specific type
# note: the device is STM32F412CG, not all F412 pins are available
MCU STM32F4xx STM32F412Rx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_BVMT_PDBex

env AP_PERIPH 1

# crystal frequency
OSCILLATOR_HZ 8000000

# ChibiOS system timer
STM32_ST_USE_TIMER 5

BRD_BOOT_DELAY 3000
define BOOT_DELAY 3000
BOOT_DELAY 3000
HAL_DEFAULT_BOOT_DELAY 3000
define  HAL_DEFAULT_BOOT_DELAY 3000

# ++++++++++++++++++++++++++++++++++++++++ Flash: ++++++++++++++++
# store parameters in pages 2 and 3
STORAGE_FLASH_PAGE 2
define HAL_STORAGE_SIZE 8192

# bootloader starts firmware at 64k
FLASH_RESERVE_START_KB 64

# bootloader embedding / bootloader flashing not available
define AP_BOOTLOADER_FLASHING_ENABLED 0

# 512kb flash
FLASH_SIZE_KB 512

# undef ROMFS
undef HAL_HAVE_SAFETY_SWITCH
undef IMU
# undef BOOTLOADER_DEV_LIST
undef HAL_OS_FATFS_IO
undef OSD_ENABLED
undef SDMMC1
undef AP_PERIPH_GPS_ENABLED
undef AP_PERIPH_MAG_ENABLED
undef AP_PERIPH_BARO_ENABLED
undef AP_PERIPH_AIRSPEED_ENABLED
undef AP_PERIPH_ADSB_ENABLED
undef AP_PERIPH_RANGEFINDER_ENABLED
# later: 
define AP_PERIPH_RC_OUT_ENABLED 1
# undef AP_PERIPH_BATTERY_ENABLED
# 
AP_PERIPH_BATTERY_ENABLED
define AP_PERIPH_BATTERY_ENABLED 1

# ======= Temperature:
define AP_PERIPH_DEVICE_TEMPERATURE_ENABLED 1
AP_PERIPH_DEVICE_TEMPERATURE_ENABLED 1
# ..... Set up Pins for  SPI3
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
# .... Set up  Chip Select (CS) for MAX6675:
PA4 MAX6675_CS CS
define AP_TEMPERATURE_SENSOR_ENABLED 1
define AP_TEMPERATURE_SENSOR_MAX31865_ENABLED 1 

#  Definition of programmatic  SPI-device for ArduPilot
# Try1:  Bad:  SPIDEV max6675_temp SPI3 DEVID1 MAX6675_CS MODE0 100*KHZ 100*KHZ
SPIDEV max31865 SPI3 DEVID1 MAX6675_CS MODE0  100*KHZ 100*KHZ


# ====== enable ESC control
define HAL_SERIAL_ESC_COMM_ENABLED 1
define HAL_SUPPORT_RCOUT_SERIAL 1
define HAL_WITH_ESC_TELEM 1
HAL_WITH_ESC_TELEM 1
AP_EXTENDED_ESC_TELEM_ENABLED 1
define AP_EXTENDED_ESC_TELEM_ENABLED 1

# 
define AP_PERIPH_SERIAL_OPTIONS_ENABLED 1

# pin definitions
# Now we start defining some PWM pins. We also map these pins to GPIO
# values, so users can set SERVOx_FUNCTION=-1 to determine which
# PWM outputs on the primary MCU are set up as GPIOs.
# To match HAL_PX4 we number the GPIOs for the PWM outputs
# starting at 50.

PB9  TIM4_CH4  TIM4  PWM(1) GPIO(50)
PB8  TIM4_CH3  TIM4  PWM(2) GPIO(51)
PB5  TIM3_CH2  TIM3  PWM(3) GPIO(52)
PB4  TIM3_CH1  TIM3  PWM(4) GPIO(53)
PB3  TIM2_CH2  TIM2  PWM(5) GPIO(54) 
PA15 TIM2_CH1  TIM2  PWM(6) GPIO(55) 

PB15 TIM12_CH2 TIM12 PWM(7) GPIO(56) NODMA
PB14 TIM12_CH1 TIM12 PWM(8) GPIO(57) NODMA

# ................. PWMs: .....................
define ESC_TELEM_MAX_ESCS 16
# BRD_SAFETY_MASK 32767
# OUT_BLH_BDMASK 255
define NUM_SERVO_CHANNELS 32

PA0 EXTERN_GPIO1 OUTPUT GPIO(1) 
PA1 EXTERN_GPIO2 OUTPUT GPIO(2)

    # .......... Ser 1 settings:

define HAL_USE_SERIAL TRUE
# order of UARTs
SERIAL_ORDER EMPTY  USART1  

# USART1 :
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# USART2 in debug connector
# PA2 USART2_TX USART2
# PA3 USART2_RX USART2

# LEDs
define HAL_LED_ON 1
# LEDs
PB10 LED_BOOTLOADER OUTPUT LOW
PB2  LED            OUTPUT HIGH

# CAN bus
define HAL_CAN_DRIVER_DEFAULT 1

PA11 CAN1_RX CAN1
PA12 CAN1_TX CAN1

PB12 CAN2_RX CAN2
PB13 CAN2_TX CAN2

CAN_ORDER 1 2
define HAL_PERIPH_CAN_MIRROR 1

# pins for SWD debugging with a STlink or black-magic probe.
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD


# ====== ADC pins
# define HAL_USE_ADC FALSE
define HAL_USE_ADC TRUE
# Try, from AI: define STM32_ADC_ADC1_DMA_STREAM STM32_DMA_STREAM_ID(2, 4)
define HAL_WITH_MCU_MONITORING 1
define STM32_ADC_USE_ADC1 TRUE

# ....  ADC : ..........................................................
# ------------------ BATTERY Monitor -----------------------
# define AP_PERIPH_BATTERY_ENABLED 1
# undef PB0
PB0 BATT_VOLTAGE_SENS  ADC1 SCALE(1)
PB1 BATT2_VOLTAGE_SENS  ADC1 SCALE(1)
# PB0 BATT3_VOLTAGE_SENS ADC1 SCALE(1) ANALOG(1)

# Define pins and Coefficients:
define HAL_BATT_VOLT_PIN 8
define HAL_BATT_CURR_PIN 9
define HAL_BATT_VOLT_SCALE 1.0
define HAL_BATT_CURR_SCALE 1.0

define HAL_BATT2_VOLT_PIN 6
define HAL_BATT2_CURR_PIN 7
define HAL_BATT2_VOLT_SCALE 2.0
define HAL_BATT2_CURR_SCALE 2.0
define AP_PERIPH_BATTERY_MODEL_NAME "BVMT_PDBex"

# Set default mode to "Analogue Voltage and Current" (4)
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT2_MONITOR_DEFAULT 4

# order of I2C buses
I2C_ORDER I2C1

# Bus #0 is "internal":
define HAL_I2C_INTERNAL_MASK 1

# I2C port
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# define AP_PERIPH_RC_OUT_ENABLED 1
# define AP_PERIPH_NOTIFY_ENABLED 1

